# Local loopback settings. Copy to .env at the project root.
MC_PANEL_ENV=development
MC_PANEL_PUBLIC_ORIGIN=http://localhost:5173
# Default DB is var/panel.db at the project root. Prefer an absolute path if set.
# MC_PANEL_DB_PATH=/var/lib/mc-panel/panel.db
# Leave unset for the mock in development and disabled controls in production.
# MC_PANEL_PROFILE_PATH=/etc/mc-panel/profiles/main.toml
MC_PANEL_SESSION_IDLE=28800
MC_PANEL_SESSION_TTL=604800
MC_PANEL_UPLOAD_LIMIT=33554432
